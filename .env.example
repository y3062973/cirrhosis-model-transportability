# Copy this file to .env and fill in your own values.
# NEVER commit the filled-in .env. It is listed in .gitignore.
#
# These are placeholders only. The real credentials for the source databases live in
# your own environment, not in this repository.

DB_HOST=YOUR_HOST
DB_PORT=5432
DB_USER=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=YOUR_DATABASE

# Optional per-database names, since a local installation may name them differently.
DB_NAME_MIMIC=mimiciv3
DB_NAME_EICU=eicu
DB_NAME_NWICU=nwicu

DB_CONNECT_TIMEOUT=20
